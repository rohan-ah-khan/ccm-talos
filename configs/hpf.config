// HPF execution overrides layered on top of the repository nextflow.config.
// Launchers export their configured BASE as TALOS_BASE.
params {
    talos_base = System.getenv('TALOS_BASE')
    talos_spark_dir = System.getenv('TALOS_SPARK_DIR') ?: "${params.talos_base}/tmp/spark"

    large_files = "${params.talos_base}/resources/reference"
    processed_annotations = "${params.talos_base}/resources/prepared"
    outdir = "${params.talos_base}/resources/prepared"
    container = "${params.talos_base}/resources/container/talos_12.2.1.sif"

    ref_genome = "${params.talos_base}/resources/reference/ref.fa"
    mane = "${params.talos_base}/resources/reference/MANE.GRCh38.v1.5.summary.txt.gz"
    mane_json = "${params.talos_base}/resources/prepared/mane.json"
    ensembl_gff = "${params.talos_base}/resources/reference/Homo_sapiens.GRCh38.116.MTtoM.gff3.gz"
    ensembl_bed = "${params.talos_base}/resources/prepared/GRCh38.bed"
    ensembl_merged_bed = "${params.talos_base}/resources/prepared/GRCh38_merged.bed"
    ensembl_symbol_lookup = "${params.talos_base}/resources/prepared/GRCh38_symbol_to_ensg.json"

    alphamissense_tsv = "${params.talos_base}/resources/reference/AlphaMissense_hg38.tsv.gz"
    alphamissense_zip = "${params.talos_base}/resources/prepared/alphamissense.zip"
    mitimpact_tsv = "${params.talos_base}/resources/reference/MitImpact_db_3.1.3.txt.zip"
    mitimpact_zip = "${params.talos_base}/resources/prepared/mitimpact.zip"
    mitotip_tsv = "${params.talos_base}/resources/reference/mitotip_scores.txt"
    mitotip_zip = "${params.talos_base}/resources/prepared/mitotip.zip"
    napogee_tsv = "${params.talos_base}/resources/reference/nAPOGEE_v1.0.0.txt.zip"
    napogee_zip = "${params.talos_base}/resources/prepared/napogee.zip"

    hpo = "${params.talos_base}/resources/reference/hp.obo"
    gen2phen = "${params.talos_base}/resources/reference/genes_to_phenotype.txt"
    phenio_db = "${params.talos_base}/resources/reference/phenio.db"
    gnomad_zip = "${params.talos_base}/resources/reference/gnomad_4.1_region_merged_GRCh38_whole_genome"

    svafotate_bed = "${params.talos_base}/resources/reference/SVAFotate_reduced_gnomAD.bed.gz"
    mane_gtf = "${params.talos_base}/resources/reference/MANE.GRCh38.v1.5.ensembl_genomic.gtf.gz"
    svannotate_noncoding_bed = "${params.talos_base}/resources/reference/noncoding.sort.hg38.bed"
    ref_dict = "${params.talos_base}/resources/prepared/ref.dict"
}

outputDir = params.outdir

docker.enabled = false

singularity {
    enabled = true
    autoMounts = true
    runOptions = "--cleanenv --bind ${params.talos_base}:${params.talos_base}"
}

process {
    executor = 'slurm'
    container = params.container

    withName: 'MergeVcfsWithBcftools' {
        cpus = 4
        time = 24.h
    }
}

env {
    TMP = "${params.talos_base}/tmp"
    TMPDIR = "${params.talos_base}/tmp"
    TEMP = "${params.talos_base}/tmp"
    SPARK_LOCAL_DIRS = params.talos_spark_dir
}
